# Copie este arquivo para ".env" e ajuste os valores.
PORT=3333

# Segredo usado para assinar os tokens de login. TROQUE por um texto longo e aleatório.
# Gerar um: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-texto-longo-e-aleatorio
JWT_EXPIRES=30d

# Arquivo do banco SQLite (a pasta é criada sozinha)
DB_PATH=./data/voyage.db

# Cria a conta de teste demo / 123456 na primeira execução (use false em produção)
SEED_DEMO=true

# Origens permitidas no CORS (* libera todas; em produção liste as suas, separadas por vírgula)
CORS_ORIGIN=*
